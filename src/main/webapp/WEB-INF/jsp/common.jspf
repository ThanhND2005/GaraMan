<%@ page import="vn.garaman.web.Web2" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>GaraMan</title><link rel="stylesheet" href="<%=request.getContextPath()%>/style.css"></head><body><main><nav><a href="<%=request.getContextPath()%>/">Trang chủ</a><a href="<%=request.getContextPath()%>/services">Dịch vụ</a><a href="<%=request.getContextPath()%>/parts">Phụ tùng</a><a href="<%=request.getContextPath()%>/payment">Thanh toán</a></nav>
