<%@ page import="vn.garaman.model.*" %><%@ include file="common.jspf" %><%Invoice2 invoice=(Invoice2)request.getAttribute("invoice");%>
<%if(invoice==null){%><h1>Không tìm thấy hóa đơn</h1><%}else{%><h1>Hóa đơn <%=Web2.html(invoice.code())%></h1><p>Phiếu YC<%=invoice.request().id()%> · <%=Web2.html(invoice.request().customerName())%> · <%=Web2.html(invoice.request().licensePlate())%></p><p>Trạng thái: <strong><%=invoice.invoiceStatus()%></strong> / <strong><%=invoice.paymentStatus()%></strong></p>
<table><tr><th>Loại</th><th>Mã</th><th>Tên</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr><%for(InvoiceLine2 line:invoice.lines()){%><tr><td><%=line.type()%></td><td><%=Web2.html(line.code())%></td><td><%=Web2.html(line.name())%></td><td><%=line.quantity()%></td><td><%=line.unitPrice()%></td><td><%=line.lineTotal()%></td></tr><%}%></table><p class="amount">Tổng phải thu: <%=invoice.calculateTotal()%> đ</p>
<div class="actions"><%if("DRAFT".equals(invoice.invoiceStatus())){%><a href="<%=request.getContextPath()%>/payment?invoiceId=<%=invoice.id()%>&view=add">Bổ sung khoản mục</a><form method="post" action="<%=request.getContextPath()%>/payment"><input type="hidden" name="csrf" value="<%=Web2.csrf(session)%>"><input type="hidden" name="action" value="confirm"><input type="hidden" name="invoiceId" value="<%=invoice.id()%>"><button>Xác nhận hóa đơn</button></form><%}else{%><a href="<%=request.getContextPath()%>/payment?invoiceId=<%=invoice.id()%>&view=print">Xem trước / in hóa đơn</a><%}%></div>
<%if("CONFIRMED".equals(invoice.invoiceStatus()) && "UNPAID".equals(invoice.paymentStatus())){%><h2>Hoàn tất thanh toán</h2><p>Chỉ ghi nhận sau khi đã thực nhận đủ tiền; với chuyển khoản cần xác minh khoản tiền.</p><form method="post" action="<%=request.getContextPath()%>/payment" class="row"><input type="hidden" name="csrf" value="<%=Web2.csrf(session)%>"><input type="hidden" name="action" value="pay"><input type="hidden" name="invoiceId" value="<%=invoice.id()%>"><label>Phương thức<br><select name="method"><option value="CASH">Tiền mặt</option><option value="TRANSFER">Chuyển khoản</option><option value="CARD">Thẻ</option></select></label><label>Số tiền thực nhận<br><input type="number" name="amount" min="0" step="0.01" required></label><button>Hoàn tất thanh toán</button></form><%}%>
<%if("PAID".equals(invoice.paymentStatus())){%><p>Đã thanh toán lúc <%=invoice.paidAt()%> bằng <%=Web2.html(invoice.paymentMethod())%>.</p><%}%><p><a href="<%=request.getContextPath()%>/payment">Quay lại tìm khách</a></p><%}%></main></body></html>
